{% extends 'base.html.twig' %}

{% block title %}Liste des campagnes{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Liste des campagnes</h1>

        {% if dataCampagnes is empty %}
            <div class="alert alert-info">
                Aucune campagne disponible.
            </div>
        {% else %}
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                       
                        <th>Nom</th>
                        <th>Date de début</th>
                        <th>Date de fin</th>
                        <th>Type</th>
                        
                    </tr>
                </thead>

                <tbody>
                    {% for campagne in dataCampagnes %}
                        <tr>
                            <td>{{ campagne.nom }}</td>
                            <td>{{ campagne.dateDebutAt ?? '-' }}</td>
                            <td>{{ campagne.dateFin ?? '-' }}</td>
                            <td>{{ campagne.type }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}

