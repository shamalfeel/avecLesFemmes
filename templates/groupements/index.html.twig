{% extends 'base.html.twig' %}
{% block title %}Groupements{% endblock %}

{% block menu %}
  {{ parent() }}
{% endblock %}
{% block body %}
    <main class="contenu">
      <div class="tete-page">
        <div> 
          <h1>Groupements</h1>
          <p class="sous-titre">3 groupements suivis</p>
        </div>
        <a class="bouton" href="#">Nouveau groupement</a>
      </div>
 
      <section class="panneau" aria-labelledby="titre-liste">
        <h2 id="titre-liste" class="visuellement-cache">Liste des groupements</h2>
 
        {# <form action="{{ path('app_groupement') }}" method="post" class="recherche" role="search">
          <label for="q">Rechercher un groupement</label>
          <input id="q" name="q" type="search" placeholder="Nom ou ville">
          <button type="submit">Filtrer</button>
        </form> #}
        
        {# {{ form(formSearchGroupement) }} #}
        
        {{ form_start(formSearchGroupement, {'attr': {'class': 'recherche form-search-inline', 'role': 'search'}}) }}
            {{ form_row(formSearchGroupement.valeur, {'attr': {'class': 'form-control'}}) }}
            {{ form_row(formSearchGroupement.submit) }}
            {# {{ form_row(formSearchGroupement.submit, {'attr': {'class': 'bouton'}}) }} #}
        {{ form_end(formSearchGroupement) }}
 
        <div class="defilement">
          <table>
            <thead>
              <tr>
                <th scope="col">Groupement</th>
                <th scope="col">Téléphone</th>
                <th scope="col">Exercice en cours</th>
                <th scope="col" class="nombre">Exercices</th>
                <th scope="col"><span class="visuellement-cache">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              {% for groupement in dataGroupements %}
          
                <tr>
                  <td>
                    <a class="nom-groupement" href="{{ path('app_exercice', {'idGroupement': groupement.id}) }}">{{ groupement.nom }}</a>
                    <span class="discret">{{ groupement.adresse }}</span>
                  </td>
                  <td>{{ groupement.tel }}</td>
                  <td>
                    <span class="statut statut--en_cours">{{ groupement.exerciceEncoursDto.status }}</span>
                    <span class="discret">depuis le {{ groupement.exerciceEncoursDto.dateDebut|format_date('long') }}</span>
                  </td>
                  <td class="nombre">3</td>
                  <td><a href="#fiche-benkadi">Voir la fiche</a></td>
                </tr>
              {% endfor %}
        
          
            </tbody>
          </table>
        </div>
      </section>
    </main>
 
{% endblock %}